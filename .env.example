# Database
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
SESSION_SECRET=replace-with-at-least-32-random-characters!!

# Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent / MCP API (min 24 chars). Same value in Cursor MCP env.
MCP_API_KEY=replace-with-a-long-random-mcp-key

# Optional production rate limit (falls back to in-memory)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me

# Optional golf seed
# SEED_EMAIL=you@example.com
# SEED_PASSWORD=10-character-minimum
# SEED_HANDLE=bolbanjang
