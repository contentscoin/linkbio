{
  "mcpServers": {
    "linkbio": {
      "type": "stdio",
      "command": "node",
      "args": ["mcp/run.mjs"],
      "env": {
        "LINKBIO_BASE_URL": "http://localhost:3000",
        "MCP_API_KEY": "same-as-app-.env.local-MCP_API_KEY",
        "NODE_PATH": "./node_modules"
      }
    }
  }
}
